[user]
    name = Tim Bryant
{{- if (or (eq .chezmoi.hostname "Timothys-MacBook-Pro") (eq .chezmoi.hostname "Timothys-MacBook-Air") (eq .chezmoi.hostname "timothys-macbook-air") (eq .chezmoi.hostname "Timmybs-MacBook-Pro") (eq .chezmoi.hostname "timmybs-macbook-pro") (eq .chezmoi.os "linux") (eq .chezmoi.os "windows")) }}
    email = "{{ onepasswordRead "op://Personal/google.com-main/username" }}"
{{- else if (and (ne .chezmoi.hostname "Timothys-MacBook-Pro") (ne .chezmoi.hostname "Timothys-MacBook-Air") (ne .chezmoi.hostname "timothys-macbook-air") (ne .chezmoi.hostname "Timmybs-MacBook-Pro") (ne .chezmoi.os "linux") (ne .chezmoi.os "windows")) }}
    email = "{{ onepasswordRead "op://Personal/simplisafe-okta/username" }}"
{{- else if (eq .chezmoi.os "linux") }}
    email = "{{ onepasswordRead "op://Personal/google.com-main/username" }}"
{{ end }}

[pager]
    branch = false

[init]
    defaultBranch = main

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[core]
    # editor = nvim
    pager = delta
{{- if (eq .chezmoi.os "windows") }}
    fileMode = false
{{ end }}

[trim]
    bases = develop,main

[push]
    autoSetupRemote = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    side-by-side = true


    # delta detects terminal colors automatically; set one of these to disable auto-detection
    # dark = true
    # light = true

[merge]
    conflictstyle = diff3

[diff]
  colorMoved = default

{{ if (or (eq .chezmoi.hostname "Timothys-MacBook-Pro") (eq .chezmoi.hostname "Timothys-MacBook-Air") (eq .chezmoi.hostname "timothys-macbook-air") (eq .chezmoi.hostname "Timmybs-MacBook-Pro") (eq .chezmoi.hostname "timmybs-macbook-pro") (eq .chezmoi.os "linux") (eq .chezmoi.os "windows")) -}}
[pull]
    rebase = false
{{ end -}}

{{ if (and (ne .chezmoi.hostname "Timothys-MacBook-Pro") (ne .chezmoi.hostname "Timothys-MacBook-Air") (ne .chezmoi.hostname "timothys-macbook-air") (ne .chezmoi.hostname "Timmybs-MacBook-Pro") (ne .chezmoi.hostname "timmybs-macbook-pro") (ne .chezmoi.os "linux") (ne .chezmoi.os "windows")) -}}
[alias]
  mycommit = !git -c user.name='Tim Bryant' -c user.email='{{ onepasswordRead "op://Personal/github.com-personal/username" }}' commit
  mypush = !git -c user.name='Tim Bryant' -c user.email='{{ onepasswordRead "op://Personal/github.com-personal/username" }}' -c credential.username=timmyb824 -c credential.helper=\"!echo password={{ onepasswordRead "op://Personal/github.com-personal/gh_http_token" }}\" push
{{ end -}}
