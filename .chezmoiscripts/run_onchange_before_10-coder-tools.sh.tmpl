{{- /*
  Installs user-space tooling inside Coder workspaces only.

  The whole file renders to nothing unless we are on Linux AND the Coder agent's
  CODER=true env var is set, and chezmoi skips scripts that render empty. Other
  Linux servers are provisioned with Ansible and never run this.

  run_onchange_: re-runs only when this file's contents change. Every step is
  guarded so it is also safe to re-run (e.g. after bumping a tool list).
  Everything lands in ~/.local/bin (persistent home volume), so no root needed.
  System packages (zsh, git, curl, tar) belong in the workspace image.
*/ -}}
{{- if and (eq .chezmoi.os "linux") (env "CODER") -}}
#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$HOME/.local/bin"
mkdir -p "$BIN_DIR"
export PATH="$BIN_DIR:$PATH"

info() { printf '\033[1;34m[coder-tools]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[coder-tools]\033[0m %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

# --- prerequisites the image must provide (we cannot apt-install without root) ---
for dep in curl git tar zsh; do
  have "$dep" || warn "missing '$dep' - add it to the workspace image"
done
have curl || { warn "curl is required, aborting"; exit 1; }

case "$(uname -m)" in
  x86_64 | amd64) ARCH="x86_64"; GOARCH="amd64"; FNM_ASSET="fnm-linux" ;;
  aarch64 | arm64) ARCH="aarch64"; GOARCH="arm64"; FNM_ASSET="fnm-arm64" ;;
  *) warn "unsupported arch $(uname -m)"; exit 1 ;;
esac

# Download the latest GitHub release asset whose name ends with $2 (a regex
# suffix) and install the binary called $3 into BIN_DIR. Handles .tar.gz and
# .zip assets (zip falls back to python3 if unzip is missing).
#   install_gh_binary <owner/repo> <asset-suffix-regex> <binary-name>
install_gh_binary() {
  local repo="$1" suffix="$2" bin="$3" url tmp found
  have "$bin" && { info "$bin already installed"; return 0; }
  url="$(curl -fsSL "https://api.github.com/repos/${repo}/releases/latest" \
    | grep -oE '"browser_download_url": *"[^"]+"' \
    | grep -oE 'https://[^"]+' \
    | grep -E "${suffix}\$" | head -n1)" || true
  if [ -z "${url:-}" ]; then
    warn "no release asset matching '${suffix}' for ${repo}, skipping ${bin}"
    return 0
  fi
  info "installing ${bin} from ${url}"
  tmp="$(mktemp -d)"
  mkdir -p "$tmp/x"
  curl -fsSL "$url" -o "$tmp/pkg"
  case "$url" in
    *.zip)
      if have unzip; then unzip -q "$tmp/pkg" -d "$tmp/x"; else python3 -m zipfile -e "$tmp/pkg" "$tmp/x"; fi ;;
    *) tar -xzf "$tmp/pkg" -C "$tmp/x" ;;
  esac
  found="$(find "$tmp/x" -type f -name "$bin" | head -n1)"
  if [ -n "$found" ]; then
    install -m 0755 "$found" "$BIN_DIR/$bin"
  else
    warn "${bin} not found inside ${url}"
  fi
  rm -rf "$tmp"
}

# --- uv (Python) ---
if have uv; then
  info "uv already installed"
else
  info "installing uv"
  curl -LsSf https://astral.sh/uv/install.sh | UV_NO_MODIFY_PATH=1 sh
fi
# Make a default interpreter available (no-op if one is already managed by uv)
uv python install || warn "uv python install failed (will retry next change)"

# uv tools, as "package:executable". ansible-core is the package that actually
# ships the ansible* executables (the plain `ansible` package exposes none).
UV_TOOLS=(
  "pre-commit:pre-commit"
  "ansible-core:ansible"
  "black:black"
  "isort:isort"
  "ruff:ruff"
  "pytest:pytest"
  "sourcery:sourcery"
)
for entry in "${UV_TOOLS[@]}"; do
  pkg="${entry%%:*}"
  bin="${entry##*:}"
  if have "$bin"; then
    info "$bin already installed"
  else
    info "uv tool install $pkg"
    uv tool install "$pkg" || warn "$pkg install failed (will retry next change)"
  fi
done

# --- prompt / navigation ---
if have starship; then
  info "starship already installed"
else
  info "installing starship"
  curl -sS https://starship.rs/install.sh | sh -s -- --yes --bin-dir "$BIN_DIR"
fi

if have zoxide; then
  info "zoxide already installed"
else
  info "installing zoxide"
  curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh
fi

# --- fzf (zshrc sources ~/.fzf.zsh on Linux) ---
if [ ! -d "$HOME/.fzf" ]; then
  info "installing fzf"
  git clone --depth 1 https://github.com/junegunn/fzf.git "$HOME/.fzf"
fi
if [ ! -f "$HOME/.fzf.zsh" ]; then
  "$HOME/.fzf/install" --bin --key-bindings --completion --no-update-rc --no-bash --no-fish
  ln -sf "$HOME/.fzf/bin/fzf" "$BIN_DIR/fzf"
fi

# --- CLI niceties referenced by the zsh/fzf config ---
install_gh_binary sharkdp/fd "${ARCH}-unknown-linux-musl\\.tar\\.gz" fd
install_gh_binary sharkdp/bat "${ARCH}-unknown-linux-musl\\.tar\\.gz" bat
install_gh_binary eza-community/eza "eza_${ARCH}-unknown-linux-musl\\.tar\\.gz" eza

# --- shell hooks used by packages.zsh ---
if have direnv; then
  info "direnv already installed"
else
  info "installing direnv"
  curl -sfL https://direnv.net/install.sh | bin_path="$BIN_DIR" bash
fi

# atuin: Ansible builds it with `cargo install`; a prebuilt release is much faster.
# Run `atuin login` yourself to enable sync (no credentials are stored here).
install_gh_binary atuinsh/atuin "atuin-${ARCH}-unknown-linux-musl\\.tar\\.gz" atuin

install_gh_binary Schniz/fnm "${FNM_ASSET}\\.zip" fnm

# --- ghq + fzf-git.sh (packages.zsh sources ~/ghq/github.com/junegunn/fzf-git.sh) ---
install_gh_binary x-motemen/ghq "ghq_linux_${GOARCH}\\.zip" ghq
if have ghq; then
  if [ -d "$HOME/ghq/github.com/junegunn/fzf-git.sh" ]; then
    info "fzf-git.sh already cloned"
  else
    info "ghq get fzf-git.sh"
    ghq get https://github.com/junegunn/fzf-git.sh
  fi
else
  warn "ghq not available, skipping fzf-git.sh"
fi

# --- ripgrep (no root: take the release tarball, not the .deb) ---
install_gh_binary BurntSushi/ripgrep "${ARCH}-unknown-linux-musl\\.tar\\.gz" rg

# --- zellij ---
install_gh_binary zellij-org/zellij "zellij-${ARCH}-unknown-linux-musl\\.tar\\.gz" zellij

info "done installing coder tools"
{{- end -}}
