#!/usr/bin/env bash
set -euo pipefail

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
cat > "$tmp"

mcp="$(cat <<'JSON'
{
  "cloudflare-docs": {
    "command": "npx",
    "args": [
      "-y",
      "mcp-remote",
      "https://docs.mcp.cloudflare.com/mcp"
    ],
    "type": "stdio"
  },
  "cloudflare-api": {
    "type": "http",
    "url": "https://mcp.cloudflare.com/mcp"
  },
  "context7": {
    "command": "npx",
    "args": [
      "-y",
      "@upstash/context7-mcp"
    ],
    "type": "stdio"
  },
  "grafana-homelab": {
    "command": "uvx",
    "args": [
      "mcp-grafana"
    ],
    "env": {
      "GRAFANA_URL": "{{ onepasswordRead "op://Personal/homelab-grafana/url" }}",
      "GRAFANA_TOKEN": "{{ onepasswordRead "op://Personal/homelab-grafana/homelab-sa-token" }}"
    },
    "type": "stdio"
  },
  "fetch": {
    "command": "uvx",
    "args": [
      "mcp-server-fetch"
    ],
    "type": "stdio"
  },
  "filesystem": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-filesystem",
      {{ if eq .chezmoi.os "linux" -}}
      "/home/tbryant/DEV",
      "/home/tbryant/ghq"
      {{ else -}}
      "/Users/timothybryant/DEV",
      "/Users/timothybryant/ghq"
      {{ end -}}
    ],
    "type": "stdio"
  },
  "git": {
    "command": "uvx",
    "args": [
      "mcp-server-git"
    ],
    "type": "stdio"
  },
  "github": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-github"
    ],
    "env": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ onepasswordRead "op://Hermes/github-personal-access-token/credential" }}"
    },
    "type": "stdio"
  },
  "memory": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-memory"
    ],
    "env": {
      "MEMORY_FILE_PATH": ""
    },
    "type": "stdio"
  },
  "sequential-thinking": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-sequential-thinking"
    ],
    "type": "stdio"
  },
  "server-puppeteer": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-puppeteer"
    ],
    "type": "stdio"
  },
  "playwright": {
    "command": "npx",
    "args": [
      "-y",
      "@playwright/mcp@latest"
    ],
    "type": "stdio"
  },
  "chrome-devtools": {
    "command": "npx",
    "args": [
      "-y",
      "chrome-devtools-mcp@latest"
    ],
    "type": "stdio"
  },
  "time": {
    "command": "uvx",
    "args": [
      "mcp-server-time"
    ],
    "type": "stdio"
  },
  "magic": {
    "command": "npx",
    "args": [
      "-y",
      "@21st-dev/magic@latest"
    ],
    "env": {
      "API_KEY": "{{ onepasswordRead "op://Personal/magic-mcp/dev-api-key" }}"
    },
    "type": "stdio"
  },
  "postgres": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-postgres",
      "{{ onepasswordRead "op://Personal/homelab-postgres/conn-string" }}"
    ],
    "env": {},
    "type": "stdio"
  },
  "degoog": {
    "url": "https://degoog-mcp.local.timmybtech.com/mcp",
    "headers": {
      "Authorization": "Bearer {{ onepasswordRead "op://Personal/degoog/mcp-auth-token" }}"
    },
    "type": "http"
  }
}
JSON
)"

if [[ -s "$tmp" ]]; then
  jq --argjson mcp "$mcp" '.mcpServers = $mcp' "$tmp"
else
  jq -n --argjson mcp "$mcp" '{mcpServers: $mcp}'
fi
